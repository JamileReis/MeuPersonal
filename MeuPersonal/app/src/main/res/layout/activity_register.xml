<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101411" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="26dp" android:paddingTop="44dp">
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:gravity="center"
            android:text="MP" android:textColor="#101411" android:textSize="22sp"
            android:textStyle="bold" android:background="#B7F36B" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Crie sua conta"
            android:textColor="#F4F5F2" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="22dp"
            android:text="Comece a receber sugestões de treino alinhadas ao seu perfil."
            android:textColor="#A8B0A8" android:textSize="14sp" />
        <EditText android:id="@+id/editNomeCadastro" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="12dp" android:hint="Seu nome"
            android:inputType="textPersonName" android:paddingHorizontal="16dp"
            android:textColor="#F4F5F2" android:textColorHint="#8C958C" android:backgroundTint="#3A443B" />
        <EditText android:id="@+id/editEmailCadastro" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="12dp" android:hint="E-mail"
            android:inputType="textEmailAddress" android:paddingHorizontal="16dp"
            android:textColor="#F4F5F2" android:textColorHint="#8C958C" android:backgroundTint="#3A443B" />
        <EditText android:id="@+id/editSenhaCadastro" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginBottom="18dp" android:hint="Senha (mínimo 6 caracteres)"
            android:inputType="textPassword" android:paddingHorizontal="16dp"
            android:textColor="#F4F5F2" android:textColorHint="#8C958C" android:backgroundTint="#3A443B" />
        <Button android:id="@+id/btnCriarConta" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="Cadastrar" android:textAllCaps="false"
            android:textColor="#101411" android:textStyle="bold" android:backgroundTint="#B7F36B" />
        <ProgressBar android:id="@+id/progressCadastro" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" android:indeterminateTint="#B7F36B"
            android:visibility="gone" />
        <TextView android:id="@+id/linkIrLogin" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" android:padding="12dp"
            android:text="Já tem conta? Entrar" android:textColor="#B7F36B"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
