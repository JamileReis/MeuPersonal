<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <action android:id="@+id/action_global_login" app:destination="@id/loginFragment" app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
    <action android:id="@+id/action_global_dashboard" app:destination="@id/dashboardFragment" app:popUpTo="@id/loginFragment" app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.meupersonal.presentation.login.LoginFragment"
        android:label="Entrar">
        <action android:id="@+id/action_login_to_register" app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.meupersonal.presentation.login.RegisterFragment"
        android:label="Cadastrar">
        <action android:id="@+id/action_register_to_login" app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.meupersonal.presentation.dashboard.DashboardFragment"
        android:label="Início">
        <action android:id="@+id/action_dashboard_to_treino_dia" app:destination="@id/treinoDiaFragment" />
    </fragment>

    <fragment
        android:id="@+id/listaTreinosFragment"
        android:name="com.meupersonal.presentation.treino.ListaTreinosFragment"
        android:label="Treinos">
        <action android:id="@+id/action_lista_to_treino_dia" app:destination="@id/treinoDiaFragment" />
    </fragment>

    <fragment
        android:id="@+id/especificacoesFragment"
        android:name="com.meupersonal.presentation.especificacoes.EspecificacoesFragment"
        android:label="Meu perfil">
        <action android:id="@+id/action_perfil_to_dashboard" app:destination="@id/dashboardFragment" app:popUpTo="@id/loginFragment" app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/treinoDiaFragment"
        android:name="com.meupersonal.presentation.treino.TreinoDiaFragment"
        android:label="Treino do dia">
        <action android:id="@+id/action_treino_to_prompt" app:destination="@id/promptTreinoFragment" />
        <action android:id="@+id/action_treino_to_exercicio" app:destination="@id/exercicioDetalheFragment" />
    </fragment>
    <fragment
        android:id="@+id/exercicioDetalheFragment"
        android:name="com.meupersonal.presentation.treino.ExercicioDetalheFragment"
        android:label="Exercício" />
    <fragment
        android:id="@+id/promptTreinoFragment"
        android:name="com.meupersonal.presentation.treino.PromptTreinoFragment"
        android:label="Alterar treino" />

</navigation>