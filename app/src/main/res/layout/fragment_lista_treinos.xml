<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#101411">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEU PROGRAMA" android:textColor="#B7F36B" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.14" />
    <TextView android:id="@+id/textTituloPlano" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Seus treinos" android:textColor="#F4F5F2" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/textObservacoes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" android:text="Plano ajustado ao seu perfil" android:textColor="#A8B0A8" android:textSize="14sp" />
    <TextView android:id="@+id/textVazio" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="Seu plano aparecerá aqui depois de configurar seu perfil." android:textColor="#A8B0A8" android:textSize="14sp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerListaTreinos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
    <Button android:id="@+id/btnNovoTreino" android:layout_width="match_parent" android:layout_height="56dp" android:text="Gerar novo plano" android:textAllCaps="false" android:textColor="#101411" android:textStyle="bold" android:backgroundTint="#B7F36B" />
</LinearLayout>