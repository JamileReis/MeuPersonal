<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101411"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLANO PERSONALIZADO"
            android:textColor="#B7F36B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTituloTreino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Seu treino personalizado"
            android:textColor="#F4F5F2"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textObjetivoTreino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#A8B0A8"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerDiasTreino"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#B7F36B"
            android:contentDescription="Selecionar dia do treino" />

        <TextView
            android:id="@+id/textNomeDiaTreino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#F4F5F2"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDescricaoTreino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#A8B0A8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Exercícios · toque para ver demonstração e detalhes"
            android:textColor="#F4F5F2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/containerExercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnIniciarTreino"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Iniciar sessão"
            android:textAllCaps="false"
            android:textColor="#101411"
            android:textStyle="bold"
            android:backgroundTint="#B7F36B" />

        <Button
            android:id="@+id/btnFinalizarTreino"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Concluir treino"
            android:textAllCaps="false"
            android:textColor="#B7F36B"
            android:backgroundTint="#202720"
            android:enabled="false" />

        <Button
            android:id="@+id/btnAlterarTreinoIa"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Alterar meu treino com IA"
            android:textAllCaps="false"
            android:textColor="#B7F36B"
            android:backgroundTint="#202720" />
    </LinearLayout>
</ScrollView>
