<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111612"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meu personal com treino do dia"
            android:textColor="#B2F45B"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textSaudacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Olá! Vamos treinar?"
            android:textColor="#F2F4F1"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Um passo de cada vez. Seu plano se adapta a você."
            android:textColor="#A7AEA7"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/cardAcessoTreinoDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#202920"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEU PLANO DE HOJE"
                android:textColor="#B2F45B"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textTituloPlano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Treino personalizado"
                android:textColor="#F2F4F1"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDescricaoPlano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Uma sugestão alinhada ao seu objetivo"
                android:textColor="#A7AEA7"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textAcaoTreino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="VER TREINO  →"
                android:textColor="#B2F45B"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Sua consistência"
            android:textColor="#F2F4F1"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textConsistencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#202920"
            android:padding="22dp"
            android:text="0 treinos concluídos nos últimos 7 dias"
            android:textColor="#D0D5D0"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
