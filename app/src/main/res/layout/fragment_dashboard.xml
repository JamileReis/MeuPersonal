<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#101411">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEU PERSONAL  /  HOJE" android:textColor="#B7F36B" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" />
        <TextView android:id="@+id/textSaudacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Olá! Vamos treinar?" android:textColor="#F4F5F2" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="Um passo de cada vez. Seu plano se adapta a você." android:textColor="#A8B0A8" android:textSize="15sp" />
        <LinearLayout android:id="@+id/cardAcessoTreinoDia" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#202720" android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/textCardRotulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEU PLANO DE HOJE" android:textColor="#B7F36B" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/textCardTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Treino personalizado" android:textColor="#F4F5F2" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/textCardDetalhe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Uma sugestão alinhada ao seu objetivo" android:textColor="#A8B0A8" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="VER TREINO  →" android:textColor="#B7F36B" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Sua consistência" android:textColor="#F4F5F2" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/textProgresso" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="18dp" android:text="Treinos concluídos nos últimos 7 dias" android:textColor="#C7CEC6" android:textSize="14sp" android:background="#202720" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Dica: ajuste seu objetivo e suas limitações no perfil para receber sugestões mais adequadas." android:textColor="#8B958C" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
