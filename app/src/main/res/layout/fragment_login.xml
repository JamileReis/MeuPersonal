<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#101411">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingTop="52dp" android:paddingBottom="32dp">
        <TextView android:layout_width="64dp" android:layout_height="64dp" android:gravity="center"
            android:text="MP" android:textStyle="bold" android:textSize="22sp" android:textColor="#101411"
            android:background="#B7F36B" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="MEU PERSONAL" android:textColor="#B7F36B" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.16" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Seu próximo nível começa hoje." android:textColor="#F4F5F2" android:textSize="30sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="30dp"
            android:text="Treinos feitos para você, seus objetivos e seu ritmo." android:textColor="#A8B0A8" android:textSize="15sp" android:gravity="center" />
        <EditText android:id="@+id/editEmail" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="12dp" android:hint="E-mail" android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp" android:textColor="#F4F5F2" android:textColorHint="#8C958C" android:backgroundTint="#3A443B" />
        <EditText android:id="@+id/editSenha" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="20dp" android:hint="Senha" android:inputType="textPassword"
            android:paddingHorizontal="16dp" android:textColor="#F4F5F2" android:textColorHint="#8C958C" android:backgroundTint="#3A443B" />
        <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Entrar" android:textAllCaps="false" android:textStyle="bold" android:textColor="#101411" android:backgroundTint="#B7F36B" />
        <ProgressBar android:id="@+id/progressLogin" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginTop="14dp" android:indeterminateTint="#B7F36B" android:visibility="gone" />
        <TextView android:id="@+id/btnAlternarModo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:padding="12dp" android:text="Não tem conta? Cadastrar"
            android:textColor="#B7F36B" android:textStyle="bold" android:textSize="14sp" />
        <TextView android:id="@+id/btnEsqueceuSenha" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:padding="10dp" android:text="Esqueci minha senha"
            android:textColor="#D4DCD4" android:textSize="14sp" />
        <TextView android:id="@+id/btnReenviarConfirmacao" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:padding="10dp" android:text="Reenviar confirmação de e-mail"
            android:textColor="#A8B0A8" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="Ao continuar, você confirma que está apto(a) a praticar atividade física. Em caso de dúvidas, consulte um profissional de saúde."
            android:textColor="#778078" android:textSize="12sp" android:gravity="center" />
    </LinearLayout>
</ScrollView>
