<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101411"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETALHE DO EXERCÍCIO"
            android:textColor="#B7F36B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/textDetalheNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Exercício"
            android:textColor="#F4F5F2"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetalheGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Grupo muscular"
            android:textColor="#A8B0A8"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:background="#202720">

            <ImageView
                android:id="@+id/imageDetalheExercicio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Demonstração do exercício"
                android:scaleType="centerCrop" />

            <ProgressBar
                android:id="@+id/progressImagemExercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#B7F36B" />

            <TextView
                android:id="@+id/textImagemExercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#CC101411"
                android:padding="8dp"
                android:text="Preparando demonstração..."
                android:textColor="#F4F5F2"
                android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:background="#202720"
            android:padding="14dp">

            <TextView
                android:id="@+id/textDetalheSeries"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F4F5F2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDetalheReps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F4F5F2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDetalheDescanso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F4F5F2"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textDetalheIntensidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:textColor="#B7F36B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textDetalheCarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#A8B0A8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Como executar"
            android:textColor="#F4F5F2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDetalheInstrucao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:textColor="#C7CEC6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/textDetalheDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textColor="#8B958C"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnVoltarTreino"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Voltar ao treino"
            android:textAllCaps="false"
            android:textColor="#B7F36B"
            android:backgroundTint="#202720" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="#202720"
            android:padding="14dp"
            android:text="Se sentir dor ou desconforto, interrompa o exercício e procure orientação profissional."
            android:textColor="#C7CEC6"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
